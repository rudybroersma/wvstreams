else
  with_xplc=no
fi

	LIBS="$LIBS_save"
	xplc_pc="xplc-${xplc_version}"
    fi
    # What if we can't find it?
    if test "$with_xplc" = "no" && test -d xplc; then
        if test -z "$CPPFLAGS"; then
        CPPFLAGS="-I\$(WVSTREAMS)/xplc/include"
    else
