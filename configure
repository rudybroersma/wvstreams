    fi

        if test -z "$LDFLAGS"; then
        LDFLAGS="-L\$(WVSTREAMS)/xplc"
    else
        LDFLAGS="$LDFLAGS -L\$(WVSTREAMS)/xplc"
    fi



subdirs="$subdirs xplc"

        build_xplc=yes
        with_xplc='$(WVSTREAMS)/xplc'
	xplc_pc='wvxplc'
    fi
fi

