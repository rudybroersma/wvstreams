save_args() {
    ARGS=""

    while test $# -gt 0; do
        ARGS="$ARGS \"$1\""
        shift
    done

    rm -f reconfigure
    echo $0 $ARGS '"$@"' >reconfigure
    chmod +x reconfigure
}

save_args "$@"

