PACKAGE_STRING='WvStreams 4.2'
PACKAGE_BUGREPORT='wvstreams-dev@nit.ca'

ac_unique_file="streams/wvstream.cc"
# Factoring default headers for most tests.
ac_includes_default="\
#include <stdio.h>
