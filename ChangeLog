	  trunk/wvstreams/include/wvencoderstream.h,
	  trunk/wvstreams/include/wvfunctorencoder.h,
	  trunk/wvstreams/include/wvgzip.h, trunk/wvstreams/include/wvhex.h,
	  trunk/wvstreams/include/wvrsa.h, trunk/wvstreams/include/wvxor.h,
	  trunk/wvstreams/streams/wvencoderstream.cc,
	  trunk/wvstreams/utils/tests/testencoder.cc,
