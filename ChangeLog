	  trunk/wvstreams/streams/wvsplitstream.cc,
	  trunk/wvstreams/streams/wvsplitstream.h,
	  trunk/wvstreams/streams/wvstream.cc,
	  trunk/wvstreams/streams/wvstream.h,
	  trunk/wvstreams/streams/wvstreamclone.cc,
	  trunk/wvstreams/streams/wvstreamclone.h,
	  trunk/wvstreams/streams/wvstreamlist.cc,
	  trunk/wvstreams/streams/wvstreamlist.h,
