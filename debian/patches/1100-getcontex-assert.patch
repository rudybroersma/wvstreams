+++ wvstreams-salsa/utils/wvtask.cc	2024-12-04 07:22:35.973322562 +0000
@@ -67,6 +67,16 @@
 
 static int context_return;
 
+// asserting wrapper for getcontext(3).
+static int assert_getcontext(ucontext_t *__ucp)
+{
+    int result;
+
+    result = getcontext(__ucp);
+    assert(result == 0);
+
+    return result;
+}
 
 static bool use_shared_stack()
 {
